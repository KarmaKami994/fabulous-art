---
import NewsArticle from '@/components/NewsArticle.astro';
import newsData from '@/data/news.json';

export function getStaticPaths() {
  return newsData.posts.filter(p => p.published).map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = newsData.posts.find(p => p.slug === slug && p.published);
if (!post) return Astro.redirect('/en/news');
---
<NewsArticle locale="en" post={post} />
