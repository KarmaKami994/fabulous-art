---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/utils';
import newsData from '@/data/news.json';

const locale = 'en';

const latestPosts = newsData.posts
  .filter(p => p.published)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return `${monthNames[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
}
---

<BaseLayout title="Home" locale={locale} description="Hyperrealistic charcoal drawings by Fabienne Meyer, Zurich. Custom portrait commissions and portfolio.">

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content container">
      <h1 class="hero__title">{t(locale, 'home.heroTitle')}</h1>
      <p class="hero__subtitle">{t(locale, 'home.heroSubtitle')}</p>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="intro section fade-in">
    <div class="container container--narrow">
      <p class="intro__text">{t(locale, 'home.introText')}</p>
    </div>
  </section>

  <!-- Portfolio Teaser — Parallax Floating -->
  <section class="parallax-teaser section">
    <div class="container">
      <div class="parallax-teaser__floating" id="floating-container">
        <a href="/en/portfolio" class="parallax-teaser__item" data-depth="0.3" style="top: 5%; left: 2%; width: 28%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Thedanceofeternaltreads.png" alt="The Dance of Eternal Threads" loading="lazy" />
        </a>
        <a href="/en/portfolio" class="parallax-teaser__item" data-depth="1.2" style="top: 8%; right: 5%; width: 22%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Purity.png" alt="Purity" loading="lazy" />
        </a>
        <a href="/en/portfolio" class="parallax-teaser__item" data-depth="0.7" style="top: 35%; left: 18%; width: 20%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/fragile.jpg" alt="Fragile" loading="lazy" />
        </a>
        <a href="/en/portfolio" class="parallax-teaser__item" data-depth="1.8" style="top: 30%; right: 18%; width: 18%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Bornintowaste.png" alt="Born into Waste" loading="lazy" />
        </a>
        <a href="/en/portfolio" class="parallax-teaser__item" data-depth="0.5" style="bottom: 8%; left: 8%; width: 24%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/TheGraces.png" alt="The Graces" loading="lazy" />
        </a>
        <a href="/en/portfolio" class="parallax-teaser__item" data-depth="1.5" style="bottom: 5%; right: 2%; width: 26%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Insidethebox.png" alt="Inside the Box" loading="lazy" />
        </a>
        <a href="/en/portfolio" class="parallax-teaser__item" data-depth="2.0" style="top: 42%; left: 42%; width: 16%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Human.png" alt="Human" loading="lazy" />
        </a>
        <div class="parallax-teaser__cta">
          <a href="/en/portfolio">
            <h3>{t(locale, 'home.portfolioTeaser')}</h3>
            <span class="parallax-teaser__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Custom Drawing Packages -->
  <section class="packages section">
    <div class="container">
      <h2 class="packages__title fade-in">{t(locale, 'home.customDrawingTitle')}</h2>

      <div class="packages__grid">
        <!-- Portrait -->
        <div class="packages__card fade-in fade-in-delay-1">
          <h3 class="packages__card-title">{t(locale, 'home.portraitTitle')}</h3>
          <p class="packages__card-desc">{t(locale, 'home.portraitDesc')}</p>
          <a href="/en/custom-drawing#portrait" class="btn btn--outline">{t(locale, 'home.getTheDeal')}</a>
        </div>

        <!-- Family -->
        <div class="packages__card fade-in fade-in-delay-2">
          <h3 class="packages__card-title">{t(locale, 'home.familyTitle')}</h3>
          <p class="packages__card-desc">{t(locale, 'home.familyDesc')}</p>
          <a href="/en/custom-drawing#family" class="btn btn--outline">{t(locale, 'home.getTheDeal')}</a>
        </div>

        <!-- Creative -->
        <div class="packages__card fade-in fade-in-delay-3">
          <h3 class="packages__card-title">{t(locale, 'home.creativeTitle')}</h3>
          <p class="packages__card-desc">{t(locale, 'home.creativeDesc')}</p>
          <a href="/en/custom-drawing#creative" class="btn btn--outline">{t(locale, 'home.getTheDeal')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- News Teaser -->
  <section class="news-teaser section fade-in">
    <div class="container">
      <h2 class="news-teaser__title">News</h2>
      <div class="news-teaser__list">
        {latestPosts.map(post => (
          <a href={`/en/news/${post.slug}`} class="news-teaser__item">
            <time class="news-teaser__date" datetime={post.date}>{formatDate(post.date)}</time>
            <h3 class="news-teaser__headline">{post.title_en}</h3>
            <p class="news-teaser__excerpt">{post.excerpt_en}</p>
          </a>
        ))}
      </div>
      <div style="text-align: center; margin-top: var(--space-xl);">
        <a href="/en/news" class="btn btn--outline">All News →</a>
      </div>
    </div>
  </section>

</BaseLayout>

<!-- Styles are identical to DE version — using same global styles -->
<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    max-height: 1000px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background: var(--color-gray-100);
    background-image: url('/images/hero/hero_1.png');
    background-size: cover;
    background-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.4);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: 300;
    letter-spacing: 0.15em;
    color: var(--color-black);
    margin-bottom: var(--space-md);
    animation: fadeUp 1s ease forwards;
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gray-600);
    max-width: none;
    animation: fadeUp 1s ease 0.2s forwards;
    opacity: 0;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .intro { text-align: center; }
  .intro__text {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-gray-600);
    margin-inline: auto;
    max-width: 60ch;
  }

  /* Portfolio Teaser — Parallax Floating */
  .parallax-teaser__floating { position: relative; height: 600px; overflow: hidden; border-radius: var(--radius-md); background: var(--color-gray-50); }
  .parallax-teaser__item { position: absolute; display: block; border-radius: var(--radius-sm); overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); transition: box-shadow 0.3s ease; will-change: transform; }
  .parallax-teaser__item:hover { box-shadow: 0 8px 40px rgba(0, 0, 0, 0.15); z-index: 10; }
  .parallax-teaser__item img { width: 100%; height: auto; display: block; transition: transform 0.4s ease; }
  .parallax-teaser__item:hover img { transform: scale(1.05); }
  .parallax-teaser__cta { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 5; text-align: center; }
  .parallax-teaser__cta a { display: inline-flex; align-items: center; gap: var(--space-sm); padding: var(--space-md) var(--space-2xl); background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(8px); border-radius: 100px; transition: background 0.3s ease, transform 0.3s ease; text-decoration: none; }
  .parallax-teaser__cta a:hover { background: rgba(255, 255, 255, 1); transform: scale(1.05); }
  .parallax-teaser__cta h3 { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 400; color: var(--color-black); margin: 0; }
  .parallax-teaser__arrow { font-size: var(--text-xl); color: var(--color-black); transition: transform 0.3s ease; }
  .parallax-teaser__cta a:hover .parallax-teaser__arrow { transform: translateX(4px); }

  .packages__title {
    text-align: center;
    margin-bottom: var(--space-3xl);
    font-weight: 300;
    letter-spacing: 0.02em;
  }
  .packages__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl);
  }
  .packages__card {
    padding: var(--space-2xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }
  .packages__card:hover {
    border-color: var(--color-gray-400);
    box-shadow: var(--shadow-md);
  }
  .packages__card-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 400;
  }
  .packages__card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    flex: 1;
  }

  @media (max-width: 1024px) {
    .packages__grid { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
  @media (max-width: 768px) {
    .hero { min-height: 500px; }
    .parallax-teaser__floating { height: 400px; }
    .parallax-teaser__item { width: 30% !important; }
    .parallax-teaser__cta h3 { font-size: var(--text-base); }
  }

  /* News Teaser */
  .news-teaser__title { font-family: var(--font-heading); font-size: var(--text-3xl); font-weight: 300; text-align: center; margin-bottom: var(--space-2xl); }
  .news-teaser__list { display: flex; flex-direction: column; gap: 0; max-width: 800px; margin: 0 auto; }
  .news-teaser__item { display: block; padding: var(--space-lg) 0; border-bottom: 1px solid var(--color-border); text-decoration: none; transition: background var(--transition-fast); }
  .news-teaser__item:first-child { padding-top: 0; }
  .news-teaser__item:hover { background: var(--color-gray-50); margin-inline: calc(-1 * var(--space-lg)); padding-inline: var(--space-lg); border-radius: var(--radius-md); }
  .news-teaser__date { font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); }
  .news-teaser__headline { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 400; color: var(--color-text); margin-top: var(--space-xs); line-height: 1.3; }
  .news-teaser__excerpt { font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.6; margin-top: var(--space-xs); max-width: none; }
</style>

<script>
  (function() {
    const container = document.getElementById('floating-container');
    if (!container) return;
    const items = container.querySelectorAll('[data-depth]');
    if (!items.length) return;
    const sensitivity = 40;
    const easingFactor = 0.06;
    let mouseX = 0.5, mouseY = 0.5;
    const positions = new Map();
    items.forEach(item => positions.set(item, { x: 0, y: 0 }));
    container.addEventListener('mousemove', (e) => {
      const rect = container.getBoundingClientRect();
      mouseX = (e.clientX - rect.left) / rect.width;
      mouseY = (e.clientY - rect.top) / rect.height;
    });
    container.addEventListener('mouseleave', () => { mouseX = 0.5; mouseY = 0.5; });
    container.addEventListener('touchmove', (e) => {
      const touch = e.touches[0];
      const rect = container.getBoundingClientRect();
      mouseX = (touch.clientX - rect.left) / rect.width;
      mouseY = (touch.clientY - rect.top) / rect.height;
    }, { passive: true });
    function lerp(s, e, f) { return s + (e - s) * f; }
    function animate() {
      items.forEach(item => {
        const depth = parseFloat(item.dataset.depth) || 1;
        const pos = positions.get(item);
        pos.x = lerp(pos.x, (mouseX - 0.5) * sensitivity * depth, easingFactor);
        pos.y = lerp(pos.y, (mouseY - 0.5) * sensitivity * depth, easingFactor);
        item.style.transform = `translate(${pos.x}px, ${pos.y}px)`;
      });
      requestAnimationFrame(animate);
    }
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) requestAnimationFrame(animate);
  })();
</script>