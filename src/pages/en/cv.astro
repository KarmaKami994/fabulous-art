---
import BaseLayout from '@/layouts/BaseLayout.astro';
import cvData from '@/data/cv.json';
const locale = 'en';
const pageTitle = 'CV';

const totalAwards = cvData.awards.length;
const totalExhibitions = cvData.solo_exhibitions.length + cvData.group_exhibitions.length;
const allVenues = [...cvData.solo_exhibitions, ...cvData.group_exhibitions].map(e => e.venue);
const countries = new Set(allVenues.map(v => {
  const parts = v.split(',');
  return parts.length > 1 ? parts[parts.length - 1].trim() : v.trim();
}));
const totalCountries = countries.size;
---

<BaseLayout title={pageTitle} locale={locale} description="CV of Fabienne Meyer – Awards, exhibitions and publications.">

  <section class="cv-hero">
    <div class="container">
      <h1 class="cv-hero__title">CV</h1>
      <p class="cv-hero__subtitle">Fabienne Meyer · *1998 · Zurich, Switzerland</p>
    </div>
  </section>

  <section class="cv-section section fade-in">
    <div class="container">
      <div class="cv-section__grid">
        <div class="cv-section__label">
          <h2 class="cv-section__heading">Awards</h2>
          <div class="cv-section__line"></div>
        </div>
        <div class="cv-section__content">
          {cvData.awards.map((award) => (
            <div class="cv-entry cv-entry--award fade-in">
              <span class="cv-entry__year">{award.year}</span>
              <div class="cv-entry__details">
                <span class="cv-entry__badge">{award.badge}</span>
                <p class="cv-entry__title">{award.title}</p>
                <p class="cv-entry__org">{award.organization}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cv-section cv-section--alt section fade-in">
    <div class="container">
      <div class="cv-section__grid">
        <div class="cv-section__label">
          <h2 class="cv-section__heading">Solo Exhibitions</h2>
          <div class="cv-section__line"></div>
        </div>
        <div class="cv-section__content">
          {cvData.solo_exhibitions.map((ex) => (
            <div class="cv-entry fade-in">
              <span class="cv-entry__year">{ex.year}</span>
              <div class="cv-entry__details">
                <p class="cv-entry__title">
                  "{ex.title}"
                  {ex.digital && <span class="cv-entry__tag">digital</span>}
                </p>
                <p class="cv-entry__org">{ex.venue}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cv-section section fade-in">
    <div class="container">
      <div class="cv-section__grid">
        <div class="cv-section__label">
          <h2 class="cv-section__heading">Group Exhibitions</h2>
          <div class="cv-section__line"></div>
        </div>
        <div class="cv-section__content">
          {cvData.group_exhibitions.map((ex) => (
            <div class="cv-entry fade-in">
              <span class="cv-entry__year">{ex.year}</span>
              <div class="cv-entry__details">
                <p class="cv-entry__title">
                  {ex.title}
                  {ex.digital && <span class="cv-entry__tag">digital</span>}
                </p>
                <p class="cv-entry__org">{ex.venue}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cv-section cv-section--alt section fade-in">
    <div class="container">
      <div class="cv-section__grid">
        <div class="cv-section__label">
          <h2 class="cv-section__heading">Publications</h2>
          <div class="cv-section__line"></div>
        </div>
        <div class="cv-section__content">
          {cvData.publishing.map((pub) => (
            <div class="cv-entry fade-in">
              <span class="cv-entry__year">{pub.year || ''}</span>
              <div class="cv-entry__details">
                <p class="cv-entry__title">{pub.description_en}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cv-stats section fade-in">
    <div class="container">
      <div class="cv-stats__grid">
        <div class="cv-stats__item fade-in fade-in-delay-1">
          <span class="cv-stats__number">{totalAwards}</span>
          <span class="cv-stats__label">Awards</span>
        </div>
        <div class="cv-stats__item fade-in fade-in-delay-2">
          <span class="cv-stats__number">{totalExhibitions}</span>
          <span class="cv-stats__label">Exhibitions</span>
        </div>
        <div class="cv-stats__item fade-in fade-in-delay-3">
          <span class="cv-stats__number">{totalCountries}</span>
          <span class="cv-stats__label">Countries</span>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .cv-hero { padding-top: calc(var(--header-height) + var(--space-5xl)); padding-bottom: var(--space-4xl); background: var(--color-black); color: var(--color-white); text-align: center; }
  .cv-hero__title { font-family: var(--font-heading); font-size: var(--text-5xl); font-weight: 300; letter-spacing: 0.08em; margin-bottom: var(--space-md); animation: fadeUp 1s ease forwards; }
  .cv-hero__subtitle { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 400; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-gray-400); max-width: none; animation: fadeUp 1s ease 0.15s forwards; opacity: 0; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  .cv-section { padding-block: var(--space-3xl); }
  .cv-section--alt { background: var(--color-gray-50); }
  .cv-section__grid { display: grid; grid-template-columns: 260px 1fr; gap: var(--space-3xl); }
  .cv-section__label { position: relative; }
  .cv-section__heading { font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 400; letter-spacing: 0.01em; position: sticky; top: calc(var(--header-height) + var(--space-xl)); }
  .cv-section__line { width: 40px; height: 1px; background: var(--color-black); margin-top: var(--space-md); position: sticky; top: calc(var(--header-height) + var(--space-xl) + 3rem); }
  .cv-section__content { display: flex; flex-direction: column; }
  .cv-entry { display: grid; grid-template-columns: 60px 1fr; gap: var(--space-lg); padding: var(--space-lg) 0; border-bottom: 1px solid var(--color-border); align-items: baseline; }
  .cv-entry:last-child { border-bottom: none; }
  .cv-entry__year { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 600; color: var(--color-text-secondary); min-width: 50px; }
  .cv-entry__details { display: flex; flex-direction: column; gap: var(--space-xs); }
  .cv-entry__title { font-family: var(--font-body); font-size: var(--text-base); font-weight: 500; color: var(--color-text); max-width: none; line-height: 1.5; }
  .cv-entry__org { font-size: var(--text-sm); color: var(--color-text-secondary); max-width: none; }
  .cv-entry__tag { display: inline-block; font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-text-muted); background: var(--color-gray-100); padding: 2px 8px; border-radius: 3px; margin-left: var(--space-xs); vertical-align: middle; }
  .cv-entry--award .cv-entry__badge { display: inline-block; font-family: var(--font-body); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-black); background: var(--color-gray-100); border: 1px solid var(--color-gray-300); padding: 4px 12px; border-radius: 3px; margin-bottom: var(--space-xs); width: fit-content; }
  .cv-stats { background: var(--color-black); color: var(--color-white); padding-block: var(--space-4xl); }
  .cv-stats__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2xl); text-align: center; }
  .cv-stats__item { display: flex; flex-direction: column; gap: var(--space-sm); }
  .cv-stats__number { font-family: var(--font-heading); font-size: var(--text-5xl); font-weight: 300; line-height: 1; letter-spacing: -0.02em; }
  .cv-stats__label { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-gray-400); }
  @media (max-width: 768px) {
    .cv-section__grid { grid-template-columns: 1fr; gap: var(--space-xl); }
    .cv-section__heading { position: static; }
    .cv-section__line { position: static; }
    .cv-entry { grid-template-columns: 50px 1fr; gap: var(--space-md); }
    .cv-hero { padding-top: calc(var(--header-height) + var(--space-3xl)); padding-bottom: var(--space-3xl); }
    .cv-stats__grid { grid-template-columns: 1fr; gap: var(--space-2xl); }
  }
</style>
