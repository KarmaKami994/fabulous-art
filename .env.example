# ==========================================================================
# Environment variables for the order function (functions/api/order.ts).
#
# In production these are set in the Cloudflare Pages dashboard
# (Settings → Environment variables), NOT in a committed file.
# For local development with `wrangler pages dev`, copy this file to
# .dev.vars and fill in real values.
#
# The R2 bucket is NOT configured via env vars — it is a binding named
# ORDER_IMAGES (Pages → Settings → Functions → R2 bucket bindings).
# ==========================================================================

# Mailjet (https://app.mailjet.com/account/apikeys)
MAILJET_API_KEY=your_api_key
MAILJET_SECRET_KEY=your_secret_key
MAILJET_FROM_EMAIL=info@fabulous-art.ch
MAILJET_FROM_NAME=FABulousART

# Order notifications go here
FABIENNE_EMAIL=info.fabulousart@gmail.com

# Cloudflare Turnstile secret key (REQUIRED — the API fails closed without it)
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET=your_turnstile_secret
