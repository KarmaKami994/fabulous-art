{
  "name": "fabulous-art",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "assets": "node scripts/generate-assets.mjs",
    "shop:dev": "npm run build && npx --yes wrangler@4.112.0 pages dev dist",
    "shop:db:local:init": "npx --yes wrangler@4.112.0 d1 migrations apply fabulous-art-shop --local",
    "shop:db:local:seed": "npx --yes wrangler@4.112.0 d1 execute fabulous-art-shop --local --file=./scripts/shop-seed.sql",
    "shop:db:remote:init": "npx --yes wrangler@4.112.0 d1 migrations apply fabulous-art-shop --remote"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^5.2.0",
    "jose": "^6.2.3",
    "marked": "^18.0.5",
    "read-excel-file": "^9.3.3",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/sanitize-html": "^2.16.1",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": "22.23.1"
  },
  "packageManager": "npm@10.9.8"
}
