---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/utils';

const locale = 'de';
---

<BaseLayout title="Home" locale={locale} description="Hyperrealistische Kohlezeichnungen von Fabienne Meyer, Zürich. Individuelle Auftragszeichnungen und Portfolio.">

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content container">
      <h1 class="hero__title">{t(locale, 'home.heroTitle')}</h1>
      <p class="hero__subtitle">{t(locale, 'home.heroSubtitle')}</p>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="intro section fade-in">
    <div class="container container--narrow">
      <p class="intro__text">{t(locale, 'home.introText')}</p>
    </div>
  </section>

  <!-- Portfolio Teaser — Parallax Floating -->
  <section class="parallax-teaser section">
    <div class="container">
      <div class="parallax-teaser__floating" id="floating-container">
        <a href="/de/portfolio" class="parallax-teaser__item" data-depth="0.3" style="top: 5%; left: 2%; width: 28%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Thedanceofeternaltreads.png" alt="The Dance of Eternal Threads" loading="lazy" />
        </a>
        <a href="/de/portfolio" class="parallax-teaser__item" data-depth="1.2" style="top: 8%; right: 5%; width: 22%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Purity.png" alt="Purity" loading="lazy" />
        </a>
        <a href="/de/portfolio" class="parallax-teaser__item" data-depth="0.7" style="top: 35%; left: 18%; width: 20%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/fragile.jpg" alt="Fragile" loading="lazy" />
        </a>
        <a href="/de/portfolio" class="parallax-teaser__item" data-depth="1.8" style="top: 30%; right: 18%; width: 18%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Bornintowaste.png" alt="Born into Waste" loading="lazy" />
        </a>
        <a href="/de/portfolio" class="parallax-teaser__item" data-depth="0.5" style="bottom: 8%; left: 8%; width: 24%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/TheGraces.png" alt="The Graces" loading="lazy" />
        </a>
        <a href="/de/portfolio" class="parallax-teaser__item" data-depth="1.5" style="bottom: 5%; right: 2%; width: 26%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Insidethebox.png" alt="Inside the Box" loading="lazy" />
        </a>
        <a href="/de/portfolio" class="parallax-teaser__item" data-depth="2.0" style="top: 42%; left: 42%; width: 16%;">
          <img src="https://pub-4c1a1d3bcc4f437faf31c8e1bea0cb6c.r2.dev/portfolio/Thumbnail/Human.png" alt="Human" loading="lazy" />
        </a>

        <!-- Center CTA overlay -->
        <div class="parallax-teaser__cta">
          <a href="/de/portfolio">
            <h3>{t(locale, 'home.portfolioTeaser')}</h3>
            <span class="parallax-teaser__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Custom Drawing Packages -->
  <section class="packages section">
    <div class="container">
      <h2 class="packages__title fade-in">{t(locale, 'home.customDrawingTitle')}</h2>

      <div class="packages__grid">
        <!-- Portrait -->
        <div class="packages__card fade-in fade-in-delay-1">
          <h3 class="packages__card-title">{t(locale, 'home.portraitTitle')}</h3>
          <p class="packages__card-desc">{t(locale, 'home.portraitDesc')}</p>
          <a href="/de/custom-drawing#portrait" class="btn btn--outline">{t(locale, 'home.getTheDeal')}</a>
        </div>

        <!-- Family -->
        <div class="packages__card fade-in fade-in-delay-2">
          <h3 class="packages__card-title">{t(locale, 'home.familyTitle')}</h3>
          <p class="packages__card-desc">{t(locale, 'home.familyDesc')}</p>
          <a href="/de/custom-drawing#family" class="btn btn--outline">{t(locale, 'home.getTheDeal')}</a>
        </div>

        <!-- Creative -->
        <div class="packages__card fade-in fade-in-delay-3">
          <h3 class="packages__card-title">{t(locale, 'home.creativeTitle')}</h3>
          <p class="packages__card-desc">{t(locale, 'home.creativeDesc')}</p>
          <a href="/de/custom-drawing#creative" class="btn btn--outline">{t(locale, 'home.getTheDeal')}</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    max-height: 1000px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background: var(--color-gray-100);
    /* Platzhalter — wird durch Hero-Bild ersetzt */
    background-image: url('/images/hero/hero_1.png');
    background-size: cover;
    background-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.4);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: 300;
    letter-spacing: 0.15em;
    color: var(--color-black);
    margin-bottom: var(--space-md);
    animation: fadeUp 1s ease forwards;
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gray-600);
    max-width: none;
    animation: fadeUp 1s ease 0.2s forwards;
    opacity: 0;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Intro */
  .intro {
    text-align: center;
  }

  .intro__text {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-gray-600);
    margin-inline: auto;
    max-width: 60ch;
  }

  /* Portfolio Teaser — Parallax Floating */
  .parallax-teaser__floating {
    position: relative;
    height: 600px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-gray-50);
  }

  .parallax-teaser__item {
    position: absolute;
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.3s ease;
    will-change: transform;
  }

  .parallax-teaser__item:hover {
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.15);
    z-index: 10;
  }

  .parallax-teaser__item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .parallax-teaser__item:hover img {
    transform: scale(1.05);
  }

  .parallax-teaser__cta {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    text-align: center;
    pointer-events: auto;
  }

  .parallax-teaser__cta a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-2xl);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-radius: 100px;
    transition: background 0.3s ease, transform 0.3s ease;
    text-decoration: none;
  }

  .parallax-teaser__cta a:hover {
    background: rgba(255, 255, 255, 1);
    transform: scale(1.05);
  }

  .parallax-teaser__cta:hover + .parallax-teaser__item {
    opacity: 0.8;
  }

  .parallax-teaser__cta h3 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
  }

  .parallax-teaser__arrow {
    font-size: var(--text-xl);
    color: var(--color-black);
    transition: transform 0.3s ease;
  }

  .parallax-teaser__cta a:hover .parallax-teaser__arrow {
    transform: translateX(4px);
  }

  /* Packages */
  .packages__title {
    text-align: center;
    margin-bottom: var(--space-3xl);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .packages__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl);
  }

  .packages__card {
    padding: var(--space-2xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .packages__card:hover {
    border-color: var(--color-gray-400);
    box-shadow: var(--shadow-md);
  }

  .packages__card-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 400;
  }

  .packages__card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    flex: 1;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .packages__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 500px;
    }

    .parallax-teaser__floating {
      height: 400px;
    }

    .parallax-teaser__item {
      width: 30% !important;
    }

    .parallax-teaser__cta h3 {
      font-size: var(--text-base);
    }
  }
</style>

<script>
  // Parallax Floating — Vanilla JS
  (function() {
    const container = document.getElementById('floating-container');
    if (!container) return;

    const items = container.querySelectorAll('[data-depth]');
    if (!items.length) return;

    const sensitivity = 40;
    const easingFactor = 0.06;

    let mouseX = 0.5;
    let mouseY = 0.5;
    const positions = new Map();

    items.forEach(item => {
      positions.set(item, { x: 0, y: 0 });
    });

    // Track mouse relative to container
    container.addEventListener('mousemove', (e) => {
      const rect = container.getBoundingClientRect();
      mouseX = (e.clientX - rect.left) / rect.width;
      mouseY = (e.clientY - rect.top) / rect.height;
    });

    container.addEventListener('mouseleave', () => {
      mouseX = 0.5;
      mouseY = 0.5;
    });

    // Touch support
    container.addEventListener('touchmove', (e) => {
      const touch = e.touches[0];
      const rect = container.getBoundingClientRect();
      mouseX = (touch.clientX - rect.left) / rect.width;
      mouseY = (touch.clientY - rect.top) / rect.height;
    }, { passive: true });

    // Lerp helper
    function lerp(start, end, factor) {
      return start + (end - start) * factor;
    }

    // Animation loop
    function animate() {
      items.forEach(item => {
        const depth = parseFloat(item.dataset.depth) || 1;
        const pos = positions.get(item);

        const targetX = (mouseX - 0.5) * sensitivity * depth;
        const targetY = (mouseY - 0.5) * sensitivity * depth;

        pos.x = lerp(pos.x, targetX, easingFactor);
        pos.y = lerp(pos.y, targetY, easingFactor);

        item.style.transform = `translate(${pos.x}px, ${pos.y}px)`;
      });

      requestAnimationFrame(animate);
    }

    // Start only if not reduced motion
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      requestAnimationFrame(animate);
    }
  })();
</script>