---
import BaseLayout from '@/layouts/BaseLayout.astro';
import newsData from '@/data/news.json';

const locale = 'en';
const posts = newsData.posts
  .filter(p => p.published)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const archive: Record<string, typeof posts> = {};
posts.forEach(post => {
  const d = new Date(post.date);
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  if (!archive[key]) archive[key] = [];
  archive[key].push(post);
});

const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return `${monthNames[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
}

function formatArchiveLabel(key: string): string {
  const [year, month] = key.split('-');
  return `${monthNames[parseInt(month) - 1]} ${year}`;
}
---

<BaseLayout title="News" locale={locale} description="News, exhibitions and insights from Fabienne Meyer — FABulousART.">

  <section class="news-content section">
    <div class="container news-content__grid">

      <div class="news-list">
        {posts.length === 0 && (
          <p class="news-list__empty">No posts yet.</p>
        )}
        {posts.map((post) => (
          <a href={`/en/news/${post.slug}`} class="news-card fade-in">
            {post.image && (
              <div class="news-card__image">
                <img src={post.image} alt={post.title_en} loading="lazy" />
              </div>
            )}
            <div class="news-card__content">
              <time class="news-card__date" datetime={post.date}>{formatDate(post.date)}</time>
              <h2 class="news-card__title">{post.title_en}</h2>
              <p class="news-card__excerpt">{post.excerpt_en}</p>
              <span class="news-card__link">Read more →</span>
            </div>
          </a>
        ))}
      </div>

      <aside class="news-archive">
        <h3 class="news-archive__title">Archive</h3>
        <nav class="news-archive__list">
          {Object.keys(archive).sort().reverse().map(key => (
            <a href={`#${key}`} class="news-archive__item">
              <span>{formatArchiveLabel(key)}</span>
              <span class="news-archive__count">{archive[key].length}</span>
            </a>
          ))}
        </nav>
      </aside>

    </div>
  </section>

</BaseLayout>

<style>
  .news-content { padding-top: calc(var(--header-height) + var(--space-3xl)); padding-bottom: var(--space-4xl); }
  .news-content__grid { display: grid; grid-template-columns: 1fr 260px; gap: var(--space-3xl); align-items: start; }
  .news-list { display: flex; flex-direction: column; gap: 0; }
  .news-list__empty { color: var(--color-text-muted); font-style: italic; }
  .news-card { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); padding: var(--space-xl) 0; border-bottom: 1px solid var(--color-border); text-decoration: none; transition: background var(--transition-fast); }
  .news-card:first-child { padding-top: 0; }
  .news-card:hover { background: var(--color-gray-50); margin-inline: calc(-1 * var(--space-lg)); padding-inline: var(--space-lg); border-radius: var(--radius-md); }
  .news-card:hover .news-card__link { color: var(--color-black); }
  .news-card__image { aspect-ratio: 16/9; border-radius: var(--radius-sm); overflow: hidden; margin-bottom: var(--space-sm); }
  .news-card__image img { width: 100%; height: 100%; object-fit: cover; }
  .news-card__date { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); }
  .news-card__title { font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 400; color: var(--color-text); margin-top: var(--space-xs); line-height: 1.3; }
  .news-card__excerpt { font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.6; margin-top: var(--space-sm); max-width: none; }
  .news-card__link { font-size: var(--text-sm); font-weight: 500; color: var(--color-text-muted); margin-top: var(--space-md); display: inline-block; transition: color var(--transition-fast); }
  .news-archive { position: sticky; top: calc(var(--header-height) + var(--space-xl)); }
  .news-archive__title { font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 400; margin-bottom: var(--space-lg); padding-bottom: var(--space-sm); border-bottom: 1px solid var(--color-border); }
  .news-archive__list { display: flex; flex-direction: column; }
  .news-archive__item { display: flex; justify-content: space-between; align-items: center; padding: var(--space-sm) 0; font-size: var(--text-sm); color: var(--color-text-secondary); text-decoration: none; border-bottom: 1px solid var(--color-gray-100); transition: color var(--transition-fast); }
  .news-archive__item:hover { color: var(--color-black); }
  .news-archive__count { font-size: var(--text-xs); color: var(--color-text-muted); background: var(--color-gray-100); padding: 2px 8px; border-radius: 10px; }
  @media (max-width: 768px) {
    .news-content__grid { grid-template-columns: 1fr; }
    .news-archive { position: static; order: -1; margin-bottom: var(--space-xl); }
  }
</style>
